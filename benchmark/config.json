  "adaptations": [
    {
      "id": "no-registry-login-or-push-server",
      "kind": "deployment-guard",
      "workflowFile": ".github/workflows/docker.yaml",
      "jobId": "docker",
      "fromPattern": "github.event_name != 'pull_request'",
      "toReplacement": "false && github.event_name != 'pull_request'",
      "expectedMatches": 2,
      "reason": "Login to DockerHub (if:) and Build and push (push:): no Docker Hub secrets in the benchmark org and nothing may be published; upstream's guard kept, 'false &&' in front. The image is still built for linux/amd64 and linux/arm64.",
      "blocksFullParity": true
    },
    {
      "id": "no-registry-login-test-server",
      "kind": "workflow-setting",
      "workflowFile": ".github/workflows/test-server-docker.yaml",
      "jobId": "docker",
      "fromPattern": "",
      "toReplacement": "",
      "expectedMatches": 0,
      "setPath": [
        "steps",
        "3",
        "if"
      ],
      "setValue": false,
      "reason": "Login to DockerHub has no if: upstream; no secrets in the benchmark org (step index +1: instrumentation inserts the harness step at index 0 before adaptations apply)",
      "blocksFullParity": true
    },
    {
